# Copia este archivo a .env.local y complétalo.
# .env.local NUNCA se sube a git (ya está en .gitignore).

# --- Turso -------------------------------------------------------------------
# Usa la URL https:// y no la libsql://: evita abrir un WebSocket en cada
# invocación serverless y reduce el arranque en frío (PLAN.md, sección 7.1).
#   turso db show <nombre-db> --url    -> devuelve libsql://...
#   Reemplaza el esquema libsql:// por https://
# IMPORTANTE: crea la base en la misma región donde despliegas en Vercel.
TURSO_DATABASE_URL="https://<tu-base>-<tu-org>.turso.io"
TURSO_AUTH_TOKEN=""

# --- Sesiones ----------------------------------------------------------------
# Secreto para firmar las cookies de sesión (JWT HS256). Mínimo 32 caracteres.
# Genera uno con:  openssl rand -base64 48
SESSION_SECRET=""

# --- Almacenamiento de archivos (necesario a partir de la fase 4) -------------
# Lo genera Vercel al crear un Blob Store en el proyecto.
BLOB_READ_WRITE_TOKEN=""

# --- Administrador inicial (solo para `npm run seed:admin`) ------------------
# Se usa una única vez para crear la primera cuenta. Después de ejecutarlo,
# borra estos valores y cambia la contraseña desde la aplicación.
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_FULLNAME="Administrador"
